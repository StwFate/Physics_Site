      "problemNumberInLevel": 1,
      "title": "Decelerating Box: Known Friction and Mass",
      "questionType": "Single Opposing Force",
      "helpUrl": "https://www.physicsclassroom.com/Concept-Builders/Newtons-Laws/Newtons-Second-Law-Problems/conceptBuilderHelp/help1",
      "template": "Analyze this: A frictional force of {Ffrict} N acts upon a {mass} kg rightward-moving box to accelerate it leftward. Complete the diagram.",
      "motion": {
        "velocityDirection": "right",
        "accelerationDirection": "left",
        "state": "slowing down"
      },
      "givens": [
        "Ffrict",
        "mass"
      ],
      "unknownsToSolve": [
        "Fnorm",
        "Fgrav",
        "a",
        "Fnet"
      ],
      "randomRanges": {
        "randA": {
          "description": "Mass generator parameter [0, 1)",
          "range": [
            0,
            1
          ]
        },
        "randB": {
          "description": "Friction generator parameter [0, 1)",
          "range": [
            0,
            1
          ]
        },
        "massFormula": "Math.floor(100.0 * (5.0 + randA * 10.0)) / 100.0",
        "massRange": [
          5.0,
          15.0
        ],
        "massUnit": "kg",
        "frictionFormula": "Math.floor(mass * 9.8 * (0.7 + 0.2 * randB) * 10.0) / 10.0",
        "frictionRange": [
          24.5,
          132.3
        ],
        "frictionUnit": "N"
      },
      "exactSolutionFormulas": {
        "A1_Fnorm": "mass * 9.8",
        "A2_Fgrav": "mass * 9.8",
        "A3_Ffrict": "friction",
        "A4_mass": "mass",
        "A5_acceln": "Math.floor((friction / mass) * 100.0) / 100.0",
        "A6_Fnet": "friction"
      },
      "calculationHints": [
        "Step 1: Identify the explicitly given values from the problem statement: Friction force Ffrict = {Ffrict} N, and Mass m = {mass} kg.",
        "Step 2: Relate mass to gravity force using Fgrav = m * g (where g = 9.8 N/kg).",
        "Step 3: Because vertical motion is balanced (no vertical acceleration), the normal force equals gravity: Fnorm = Fgrav.",
        "Step 4: Analyze the horizontal forces: Only friction acts horizontally. Thus, the net unbalanced force is entirely the friction force: Fnet = Ffrict.",
        "Step 5: Apply Newton's Second Law to calculate acceleration: a = Fnet / m = Ffrict / m (directed leftward)."
      ],
